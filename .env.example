DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
AUTH_SECRET="random-32-byte-hex-string"
WAYLO_BACKEND_URL="http://localhost:3001"
WAYLO_BACKEND_KEY="server-side-secret-of-at-least-32-characters"
# AI provider for conversation titles and voice (optional).
# RETO_KEY=your_api_key_here
# RETO_BASE_URL=https://api.reto.pltk.mx/v1
# RETO_MODEL=grok-4.6
# RETO_TITLE_MODEL=
# RETO_VOICE=
# Sign in with Google (optional). Without these variables the button leads to a notice instead of Google.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Discord channel that receives the like / dislike votes (optional). See docs/operations.md.
# DISCORD_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
# Discord #errors channel: server failures (AI, voice, IPS, database). Optional; nothing is sent in local development.
# DISCORD_ERRORS_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
# Public address of the site, with no trailing slash. Used for the canonical link, the sitemap and share previews (optional).
# SITE_URL=https://waylo-ai.vercel.app
