DATABASE_URL="postgresql://usuario:clave@host/neondb?sslmode=require"
AUTH_SECRET="cadena-aleatoria-de-32-bytes-en-hex"
WAYLO_BACKEND_URL="http://localhost:3001"
WAYLO_BACKEND_KEY="secreto-server-side-de-al-menos-32-caracteres"
# Proveedor de IA para el título de las conversaciones y la voz (opcionales).
# RETO_KEY=tu_api_key_aqui
# RETO_BASE_URL=https://api.reto.pltk.mx/v1
# RETO_MODEL=grok-4.6
# RETO_TITLE_MODEL=
# RETO_VOICE=
# Ingreso con Google (opcional). Sin estas variables el botón lleva a un aviso en vez de a Google.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Canal de Discord donde llegan los votos de me gusta / no me gusta (opcional). Ver docs/operaciones.md.
# DISCORD_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
# Canal de Discord #errores: fallos del servidor (IA, voz, IPS, base de datos). Opcional; no envía nada en desarrollo local.
# DISCORD_ERRORS_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
# Dirección pública del sitio, sin barra final. Se usa en el canonical, el sitemap y las vistas previas al compartir (opcional).
# SITE_URL=https://waylo-ai.vercel.app
